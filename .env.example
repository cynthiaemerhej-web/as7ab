# Copy to .env.local and fill in from your Supabase project (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Where the site is served (no trailing slash). Locally: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shown on the site as the contact address and used for "Report this listing"
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com
